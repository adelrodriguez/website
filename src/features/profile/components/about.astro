---
import { Image } from "astro:assets"
import me from "../../../shared/assets/images/me.webp"
import me2 from "../../../shared/assets/images/me-2.webp"
import { getTranslations, type Locale } from "../../../shared/i18n"
import Layout from "../../../shared/components/layout.astro"
import PageContainer from "./page-container.astro"

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = getTranslations(locale)
---

<Layout locale={locale} path="/about">
  <PageContainer emoji="👋" locale={locale} title={t.about.title}>
    <div
      class="mb-20 flex flex-col items-center justify-center gap-12 md:flex-row"
    >
      <div
        class="flex flex-col gap-4 font-light text-lg leading-relaxed md:mr-10 md:text-xl md:leading-loose"
      >
        <p>{t.about.p1}</p>
        <p>{t.about.p2}</p>
      </div>

      <div
        class="group relative mb-10 aspect-[9/10] w-64 flex-none rotate-2 overflow-hidden rounded-xl shadow-lg transition-all duration-700 ease-in-out will-change-transform hover:rotate-0 hover:scale-110 sm:w-72 sm:rounded-2xl md:m-0"
      >
        <Image
          alt="Adel"
          class="absolute inset-0 h-full w-full object-cover opacity-100 transition-opacity duration-700 ease-in-out group-hover:opacity-0"
          draggable="false"
          loading="eager"
          sizes="(min-width: 640px) 18rem, 16rem"
          src={me2}
          widths={[256, 288, 576]}
        />
        <Image
          alt="Adel"
          class="absolute inset-0 h-full w-full object-cover opacity-0 transition-opacity duration-700 ease-in-out group-hover:opacity-100"
          draggable="false"
          loading="eager"
          sizes="(min-width: 640px) 18rem, 16rem"
          src={me}
          widths={[256, 288, 576]}
        />
      </div>
    </div>
  </PageContainer>
</Layout>
