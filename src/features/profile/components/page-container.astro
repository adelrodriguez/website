---
import type { Locale } from "../../../shared/i18n"
import CodeEmoji from "../../../shared/components/code-emoji.astro"
import GoHome from "./go-home.astro"

interface Props {
  emoji: string
  locale: Locale
  title: string
}

const { emoji, locale, title } = Astro.props
---

<section class="relative mb-40 flex w-full select-none flex-col text-left font-bold">
  <CodeEmoji emoji={emoji} />

  <div class="mb-4 text-4xl leading-normal tracking-tight md:text-6xl">
    <h1 class="leading-relaxed" transition:name="section-title">{title}</h1>
  </div>
  <slot />
  <GoHome locale={locale} />
</section>
