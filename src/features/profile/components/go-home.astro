---
import { localePath } from "#shared/i18n.ts"
import { m } from "#shared/internationalization/messages.js"
import { getLocale } from "#shared/internationalization/runtime.js"
---

<div
  class="group -bottom-10 absolute left-0 flex items-center font-light text-foreground/60 hover:text-foreground"
>
  <svg
    class="mr-1 h-4 w-4"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    viewBox="0 0 24 24"
    xmlns="http://www.w3.org/2000/svg"
  >
    <title>Back home</title>
    <path
      d="M6.75 15.75 3 12m0 0 3.75-3.75M3 12h18"
      stroke-linecap="round"
      stroke-linejoin="round"></path>
  </svg>

  <a class="text-sm" href={localePath(getLocale(), "/")}>
    {m.misc_go_home()}
    <span
      class="block h-px origin-left scale-x-0 bg-foreground transition-transform duration-300 ease-out-strong group-hover:scale-x-100"
    ></span>
  </a>
</div>
