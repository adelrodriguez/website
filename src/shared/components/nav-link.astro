---
interface Props {
  external?: boolean
  href: string
  name: string
}

const { external = false, href, name } = Astro.props
---

<a
  class="group inline-block text-xl md:text-2xl"
  href={href}
  rel="noopener noreferrer"
  target={external ? "_blank" : undefined}
>
  {name}
  <span
    class="block h-px origin-left scale-x-0 bg-foreground transition-transform duration-300 ease-out-strong group-hover:scale-x-100"
  ></span>
</a>
