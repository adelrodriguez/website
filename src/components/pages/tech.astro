---
import { getTranslations, type Locale } from "../../i18n"
import Layout from "../../layouts/layout.astro"
import PageContainer from "../page-container.astro"

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = getTranslations(locale)

const tech = [
  { label: "astro", name: "Astro" },
  { label: "better-auth", name: "Better Auth" },
  { label: "bun", name: "Bun" },
  { label: "docker", name: "Docker" },
  { label: "drizzle", name: "Drizzle" },
  { label: "expo", name: "Expo" },
  { label: "fumadocs", name: "Fumadocs" },
  { label: "hono", name: "Hono" },
  { label: "nextjs", name: "Next.js" },
  { label: "postgres", name: "Postgres" },
  { label: "react-router", name: "React Router" },
  { label: "react", name: "React" },
  { label: "sqlite", name: "SQLite" },
  { label: "tailwindcss", name: "Tailwind" },
  { label: "tanstack-query", name: "TanStack Query" },
  { label: "tanstack-router", name: "TanStack Router" },
  { label: "trpc", name: "TRPC" },
  { label: "typescript", name: "TypeScript" },
  { label: "unistyles", name: "Unistyles" },
  { label: "vite", name: "Vite" },
  { label: "zod", name: "Zod" },
] as const
---

<Layout locale={locale} path="/tech">
  <PageContainer emoji="💻" locale={locale} title={t.tech.title}>
    <div class="flex flex-col justify-center gap-12">
      <p class="text-left font-light text-lg md:text-xl">{t.tech.content}</p>
      <ul
        class="mb-16 flex flex-wrap items-center justify-center gap-4 font-light"
      >
        {
          tech.map(({ name, label }) => (
            <li class="group relative">
              <span class="inline-block cursor-default px-5 py-2 transition-all duration-200 group-hover:rounded-full group-hover:bg-foreground group-hover:text-background sm:text-lg">
                {name}
              </span>
              <span
                class="pointer-events-none absolute bottom-full left-1/2 z-10 mb-2 w-max max-w-72 -translate-x-1/2 rounded-md bg-foreground px-3 py-1.5 text-center text-background text-lg opacity-0 transition-opacity duration-150 group-hover:opacity-100"
                role="tooltip"
              >
                {t.tech.tech[label]}
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </PageContainer>
</Layout>
