---
import { getTranslations, localePath, otherLocale, type Locale } from "../i18n"

interface Props {
  locale: Locale
  /** Current path without the locale prefix, e.g. "/" or "/about" */
  path: string
}

const { locale, path } = Astro.props
const target = otherLocale(locale)
const t = getTranslations(locale)
---

<a
  aria-label={t.locale[target]}
  class="inline-flex size-9 items-center justify-center rounded-md transition-colors hover:bg-accent hover:text-accent-foreground"
  href={localePath(target, path)}
>
  <svg
    class="size-4"
    fill="none"
    stroke="currentColor"
    stroke-linecap="round"
    stroke-linejoin="round"
    stroke-width="2"
    viewBox="0 0 24 24"
    xmlns="http://www.w3.org/2000/svg"
  >
    <path d="m5 8 6 6"></path>
    <path d="m4 14 6-6 2-3"></path>
    <path d="M2 5h12"></path>
    <path d="M7 2h1"></path>
    <path d="m22 22-5-10-5 10"></path>
    <path d="M14 18h6"></path>
  </svg>
  <span class="sr-only">{t.locale[target]}</span>
</a>
